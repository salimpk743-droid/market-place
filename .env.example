# Public, browser-safe configuration only.
# Never put the database password, service-role key, or LISTING_MEDIA_SECRET in NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Canonical site origin for sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://mobilemarket.pk

# Server-only (Vercel). Used to sign listing photo URLs. Never expose to the browser.
LISTING_MEDIA_SECRET=

# Server-only (Vercel). Required to read photos from the private listing-images bucket.
# Never put this in NEXT_PUBLIC_* or the browser.
SUPABASE_SERVICE_ROLE_KEY=
